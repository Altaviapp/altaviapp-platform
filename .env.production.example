# Altaviapp Platform - Production Environment Variables
# Configure these in Vercel Dashboard for each app
# DO NOT commit actual values to git!

# ===========================
# Convex Configuration (REQUIRED)
# ===========================
# Production Convex deployment URL
NEXT_PUBLIC_CONVEX_URL=https://wooden-armadillo-937.convex.cloud

# ===========================
# Application URLs (REQUIRED)
# ===========================
# Set per app in Vercel:
# - Admin: https://admin.altaviapp.com
# - Crew: https://crew.altaviapp.com
# - Parent: https://padres.altaviapp.com
NEXT_PUBLIC_APP_URL=https://admin.altaviapp.com

# ===========================
# Google Maps API (REQUIRED)
# ===========================
# Production API key with domain restrictions:
# - admin.altaviapp.com/*
# - crew.altaviapp.com/*
# - padres.altaviapp.com/*
#
# Required APIs enabled in Google Cloud Console:
# - Maps JavaScript API
# - Places API
# - Directions API
# - Geocoding API
# - Distance Matrix API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ===========================
# Convex Environment Variables
# ===========================
# Set in Convex Dashboard or via CLI:
# npx convex env set RESEND_API_KEY <value> --prod
#
# RESEND_API_KEY=<your-resend-api-key>

# ===========================
# Optional: Analytics & Monitoring
# ===========================
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
