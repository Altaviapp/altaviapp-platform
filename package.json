{
  "name": "altaviapp-platform",
  "version": "1.0.0",
  "description": "SaaS platform for school transport management with real-time tracking and safety controls",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run convex:dev\" \"npm run dev:mobile\"",
    "dev:mobile": "cd mobile && next dev",
    "dev:convex": "npm run convex:dev",
    "build": "npm run convex:build && npm run build:mobile",
    "build:mobile": "cd mobile && next build",
    "start:mobile": "cd mobile && next start",
    "convex:dev": "npx convex dev",
    "convex:build": "npx convex deploy",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix"
  },
  "keywords": [
    "school-transport",
    "fleet-management",
    "real-time-tracking",
    "saas",
    "convex",
    "bubble"
  ],
  "author": "Altaviapp Team",
  "license": "MIT",
  "dependencies": {
    "@clerk/nextjs": "^4.27.0",
    "@radix-ui/react-slot": "^1.0.2",
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "concurrently": "^8.2.2",
    "convex": "^1.29.0",
    "date-fns": "^2.30.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "next": "^14.0.0",
    "next-pwa": "^5.6.0",
    "postcss": "^8.4.32",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^13.0.0",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "jest": "^29.0.0",
    "tailwindcss-animate": "^1.0.7"
  }
}
