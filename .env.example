# Copiar a .env y completar. Docker Compose lee este archivo.

# ── Sitio ─────────────────────────────────────────────────────────────
# Dominio público (Caddy saca el certificado HTTPS solo). Detrás de un túnel: ":80".
SITE_ADDRESS=abordo.tudominio.com
APP_URL=https://abordo.tudominio.com
# Solo con túnel de Cloudflare (servidor en casa):
# SITE_ADDRESS=:80
# BIND_ADDRESS=127.0.0.1
# CLIENT_IP_HEADER=cf-connecting-ip
# CLOUDFLARE_TUNNEL_TOKEN=

# ── Base de datos (generar cada valor con: openssl rand -hex 24) ──────
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# ── Secretos de la aplicación ─────────────────────────────────────────
# Llave que cifra los vectores de rostro. Generar con: openssl rand -base64 32
# Si se pierde, los rostros registrados no se pueden leer: guardarla fuera del servidor.
FACE_KEY=
# Correo del dueño de la plataforma (entra a /plataforma).
OWNER_EMAIL=

# ── Correo (SMTP de cualquier proveedor) ──────────────────────────────
SMTP_URL=smtps://usuario:clave@smtp.proveedor.com:465
EMAIL_FROM=Abordo <acceso@tudominio.com>

# ── Notificaciones push (generar con: npx web-push generate-vapid-keys) ─
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tudominio.com

# ── Suscripción y Wompi (panel de Wompi → Desarrolladores) ────────────
PRICE_PER_STUDENT_COP=0
IVA_PERCENT=19
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# URL de eventos a registrar en Wompi: https://abordo.tudominio.com/api/wompi/events

# ── Mapas abiertos ────────────────────────────────────────────────────
# Teselas: ./scripts/maps.sh teselas   (se sirven desde /tiles)
# Rutas por calles: ./scripts/maps.sh rutas  y luego descomentar:
# OSRM_URL=http://osrm:5000

# ── Respaldos (./scripts/backup.sh) ───────────────────────────────────
BACKUP_PASSPHRASE=
