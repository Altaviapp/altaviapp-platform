# Altaviapp Platform - Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to git!

# ===========================
# Convex Configuration
# ===========================
# Get your deployment URL from https://dashboard.convex.dev
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# ===========================
# Clerk Authentication
# ===========================
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Clerk sign-in/sign-up URLs (customize if using custom domains)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ===========================
# Application Configuration
# ===========================
# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Production (uncomment when deploying)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ===========================
# Node Environment
# ===========================
NODE_ENV=development

# ===========================
# Optional: External Services
# ===========================
# WhatsApp Business API (if using)
# WHATSAPP_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=

# Google Maps API (if using instead of OpenStreetMap)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Analytics
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Monitoring/Error Tracking
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# ===========================
# Docker-Specific (optional)
# ===========================
# Enable file watching in Docker
WATCHPACK_POLLING=true

# Debugging
# DEBUG=*
# VERBOSE=true
