# Altaviapp Platform - Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to git!

# ===========================
# Convex Configuration
# ===========================
# Get your deployment URL from https://dashboard.convex.dev
NEXT_PUBLIC_CONVEX_URL=https://abundant-mastiff-673.convex.cloud

# ===========================
# Application Configuration
# ===========================
# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Production (uncomment when deploying)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ===========================
# Node Environment
# ===========================
NODE_ENV=development

# ===========================
# Google Maps API (REQUIRED)
# ===========================
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Enable these APIs in your Google Cloud project:
# - Maps JavaScript API
# - Places API (for address autocomplete)
# - Directions API (for route optimization)
# - Geocoding API (for address lookup)
# - Distance Matrix API (for distance calculations)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ===========================
# Email Service (Resend)
# ===========================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=

# ===========================
# Optional: External Services
# ===========================
# WhatsApp Business API (if using)
# WHATSAPP_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=

# Analytics
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Monitoring/Error Tracking
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# ===========================
# Docker-Specific (optional)
# ===========================
# Enable file watching in Docker
WATCHPACK_POLLING=true

# Debugging
# DEBUG=*
# VERBOSE=true
