{
  "name": "altaviapp-platform",
  "version": "1.0.0",
  "private": true,
  "description": "SaaS platform for school transport management with real-time tracking and safety controls",
  "scripts": {
    "dev": "turbo dev",
    "dev:crew": "turbo dev --filter=@altaviapp/crew",
    "dev:admin": "turbo dev --filter=@altaviapp/admin",
    "dev:parent": "turbo dev --filter=@altaviapp/parent",
    "dev:convex": "npx convex dev",
    "build": "turbo build",
    "build:crew": "turbo build --filter=@altaviapp/crew",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "keywords": [
    "school-transport",
    "fleet-management",
    "real-time-tracking",
    "saas",
    "convex",
    "pwa",
    "monorepo",
    "turborepo"
  ],
  "author": "Altaviapp Team",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^8.0.0",
    "jsdom": "^27.3.0",
    "prettier": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "turbo": "^2.3.3",
    "typescript": "^5.0.0",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "convex": "^1.29.0",
    "resend": "^6.6.0",
    "zod": "^3.25.76"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=18"
  }
}
