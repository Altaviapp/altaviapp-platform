# ── Next.js (.env.local) ─────────────────────────────────────────────
# URL del despliegue de Convex. `npx convex dev` la escribe sola en .env.local.
NEXT_PUBLIC_CONVEX_URL=

# Llave pública VAPID para notificaciones push (la misma que VAPID_PUBLIC_KEY de Convex).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Opcional: otro proveedor de teselas para el mapa. Por defecto, OpenStreetMap.
# NEXT_PUBLIC_TILE_URL=https://{s}.ejemplo.com/{z}/{x}/{y}.png

# ── Convex (se configuran con `npx convex env set NOMBRE valor`) ─────
# RESEND_API_KEY      Llave de Resend para enviar el código de acceso. Sin ella, el código sale en el log.
# EMAIL_FROM          Remitente, p. ej. "Abordo <acceso@tudominio.com>"
# APP_URL             URL pública de la app, usada en los correos de bienvenida
# VAPID_PUBLIC_KEY    Generar el par con: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY
# VAPID_SUBJECT       mailto:soporte@tudominio.com
